# Copy to .env.local (local) — real values live ONLY in .env.local and Vercel. Never commit them.
# Do not wrap values in quotes (quoted values break Vercel env parsing).

# --- Database (Neon PostgreSQL) -------------------------------------------------
# Use the pooled connection string, e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# --- Data providers (server-only) -----------------------------------------------
EXA_API_KEY=
FIRECRAWL_API_KEY=
APOLLO_API_KEY=

# --- AI reasoning (NVIDIA Build / NIM, OpenAI-compatible) -----------------------
NVIDIA_API_KEY=
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b

# --- CRM -------------------------------------------------------------------------
# HubSpot private-app token (scopes: crm.objects.contacts.read/write, crm.objects.companies.read/write)
HUBSPOT_ACCESS_TOKEN=

# --- Durable background jobs (Inngest) -------------------------------------------
# Production: both keys from the Inngest dashboard. Local dev: set INNGEST_DEV=1 and run `pnpm inngest:dev`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=

# --- Reviewer access (REQUIRED in production; the app fails closed without both) -
# Shared reviewer password (verified at login, never stored in the cookie)
APP_ACCESS_PASSWORD=
# Random 32+ char string used to sign session cookies:  openssl rand -base64 32
AUTH_SECRET=

# --- Public values only (bundled into client JS — never put secrets here) --------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Intelligence budgets (optional) ---------------------------------------------
MAX_COMPANIES_PER_EVENT=30
MAX_PEOPLE_PER_COMPANY=6
MAX_PEOPLE_SEARCH_PER_COMPANY=8
MAX_ENRICHMENTS_PER_EVENT=50
TOP_EVENTS_LIMIT=10
