# Use postgresql://… with no surrounding quotes (quoted values break Vercel env parsing).
DATABASE_URL=

EXA_API_KEY=
FIRECRAWL_API_KEY=
APOLLO_API_KEY=

NVIDIA_API_KEY=
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b

HUBSPOT_ACCESS_TOKEN=

# Inngest: durable background jobs. Get both from the Inngest dashboard and set them in Vercel.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local dev only: INNGEST_DEV=1 and run "pnpm inngest:dev"
INNGEST_DEV=

# Optional shared password gating the whole app (strongly recommended on any public deployment)
APP_ACCESS_PASSWORD=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Intelligence engine budgets (optional)
MAX_COMPANIES_PER_EVENT=30
MAX_PEOPLE_PER_COMPANY=6
MAX_PEOPLE_SEARCH_PER_COMPANY=8
MAX_ENRICHMENTS_PER_EVENT=50
TOP_EVENTS_LIMIT=10
